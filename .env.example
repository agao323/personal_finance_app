# Copy to .env for local development: `cp .env.example .env` (make dev does this
# for you). .env is gitignored. Nothing in this file is a real secret — these are
# local container credentials that never leave your machine.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=pfa
POSTGRES_PASSWORD=pfa_local_dev
POSTGRES_DB=pfa

# Published to the host in the dev override only, so you can run psql and (later)
# point Alembic at it. The base compose file does not publish it.
POSTGRES_PORT=5432

# ── API ───────────────────────────────────────────────────────────────────────
# `postgres` is the compose service name. SQLAlchemy 2 + psycopg 3 needs the
# +psycopg driver suffix; a bare postgresql:// URL selects psycopg2, which is not
# installed. In production this is a Neon connection string held in Fly secrets.
DATABASE_URL=postgresql+psycopg://pfa:pfa_local_dev@postgres:5432/pfa

# Who you are locally. Cloudflare Access is the authentication (ADR 0007) and there
# is none in front of the compose stack, so without this every request is refused.
# It must match a row in `users` — the seed creates owner@example.invalid — and it is
# ignored entirely once WEB_ORIGIN is https, so it cannot become a way into a
# deployment. Change it to try the app as a second household member.
DEV_IDENTITY_EMAIL=owner@example.invalid

# Where pytest looks. Different from DATABASE_URL because the suite runs on the
# host while the API runs in a container: `postgres` resolves only inside the
# compose network, `localhost` only outside it. The database named here is created
# and dropped by the test session — never point it at one holding real data.
TEST_DATABASE_URL=postgresql+psycopg://pfa:pfa_local_dev@localhost:5432/pfa_test

# ── Web ───────────────────────────────────────────────────────────────────────
# The only address the web service uses to reach the API, and it is server-side
# only. Locally this is the compose service name; in production it is the Fly
# .flycast private address.
#
# There is deliberately NO NEXT_PUBLIC_API_URL. The browser never learns an API
# address — it talks only to the Next.js origin, which proxies. Adding a public API
# URL would defeat the origin lock described in docs/ARCHITECTURE.md#request-path,
# and CI fails if one appears in web/.
INTERNAL_API_URL=http://api:8000

# Host port for the web app. The only port mapped by the base compose file.
WEB_PORT=3000

# ── Observability (ticket 007) ─────────────────────────────────────────────────
# Both services disable Sentry cleanly when these are unset, which is the local
# default. Server-only on purpose: a NEXT_PUBLIC_ DSN would ship to the browser and
# start sending client breadcrumbs, which on this app means balances.
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Backups (ticket 017, ADR 0008) ─────────────────────────────────────────────
# What `make backup` reads. **The production Neon connection string**, which is the
# one thing in this file that is a real secret — which is why it is empty here and
# why .env is gitignored.
#
# Copy it from the Neon console: your project → Connection Details → prefer the
# **direct** (unpooled) string, the hostname without `-pooler`. The pooled one works
# too, but this opens a single long connection and reads every table, which is what
# the direct endpoint is for.
#
# A bare `postgresql://...` is fine; the script adds the +psycopg driver suffix.
#
# Leave it unset and `make backup` says so rather than quietly backing up your local
# Docker database, which would be a file full of synthetic data named like a backup.
#
# NOTE: `make backup` does not read this file yet — it takes the variable from the
# environment. Until TD-016 (docs/exec-plans/tech-debt-tracker.md) is fixed, use the
# command in docs/runbooks/going-live.md, section C2.
BACKUP_DATABASE_URL=
